TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
CLICKER_EMAIL=
# Outer HTTP Basic Auth for a preprod host (separate from the site's own login form).
# CLICKER_BASIC_AUTH=eth-portal2-preprod.dev.hk.toppangravity.com username:password
# The site's own sign-in form, filled in only on this exact HTTPS host (separate from basic auth).
# CLICKER_FORM_LOGIN=eth-portal2-preprod.dev.hk.toppangravity.com username:password
# A fixed one-time code the site accepts after sign-in, as a preprod one can; typed on that host only.
# CLICKER_FORM_OTP=123456
# Optional: send the writer to another endpoint instead of api.anthropic.com. It speaks the
# Anthropic Messages API, or OpenAI's Chat Completions API with CLICKER_WRITER_API=openai (keep
# the /v1 in its URL then). Its key, if it checks one, goes in CLICKER_WRITER_API_KEY; no other
# key is ever sent there. CLICKER_WRITER_VISION=false is for an answer model that reads text only.
# CLICKER_WRITER_API=anthropic
# CLICKER_WRITER_BASE_URL=http://localhost:1234
# CLICKER_WRITER_API_KEY=
# CLICKER_WRITER_MODEL=claude-haiku-4-5
# CLICKER_ANSWER_MODEL=claude-sonnet-5
# CLICKER_WRITER_VISION=true
